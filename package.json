{
  "name": "devakroy-portfolio",
  "version": "1.0.0",
  "description": "AI/ML Software Engineer Portfolio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,md}\"",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "validate": "npm run lint && npm run format:check && npm run test",
    "validate:fix": "npm run lint:fix && npm run format && npm run test"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.4",
    "@vitest/coverage-v8": "^1.0.4",
    "@vitest/ui": "^1.0.4",
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "eslint": "^8.54.0",
    "jsdom": "^23.0.1",
    "prettier": "^3.1.0",
    "terser": "^5.46.0",
    "vite": "^5.0.0",
    "vitest": "^1.0.4"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0"
  }
}
